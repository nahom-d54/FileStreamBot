# Telegram
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Database
DATABASE_URL=
SESSION_NAME=FileStream

# Channels
FLOG_CHANNEL=
ULOG_CHANNEL=
UPDATES_CHANNEL=
FORCE_SUB_ID=
FORCE_UPDATES_CHANNEL=False

# Server
BIND_ADDRESS=0.0.0.0
PORT=8080
FQDN=localhost
HAS_SSL=False
NO_PORT=False
PUBLIC_URL=
# Optional. Signing key for self-contained stream URLs. If unset, a random
# secret is generated once and stored in the database (recommended).
STREAM_SECRET=
# Seconds a short /dl/<id> link may be cached before the db is queried again
STREAM_REDIRECT_TTL=3600
# Lifetime of a signed /stream/<token> URL in seconds (0 = never expires)
STREAM_TOKEN_TTL=86400
# Lifetime of the short /dl/<id> link in seconds (0 = permanent, e.g. 21600 = 6h)
SHORT_LINK_TTL=0

# Optional
WORKERS=6
MODE=primary
AUTH_USERS=
FILE_PIC=
START_PIC=
VERIFY_PIC=
SLEEP_THRESHOLD=60
